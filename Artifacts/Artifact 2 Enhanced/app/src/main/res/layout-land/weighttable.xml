<?xml version="1.0" encoding="utf-8"?>
<!-- For landscape orientation -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="#FFFFFF"
    tools:context=".WeightTableActivity">

    <!-- LEFT COLUMN: Top bar + Username + Goal + Table -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.6"
        android:orientation="vertical">

        <!-- Top bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp">

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#1976D2"
                android:text="Settings"
                android:textColor="#FFFFFF"
                android:layout_alignParentStart="true" />

            <Button
                android:id="@+id/btnWTLogout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#D32F2F"
                android:text="Logout"
                android:textColor="#FFFFFF"
                android:layout_alignParentEnd="true" />
        </RelativeLayout>

        <!-- Username -->
        <TextView
            android:id="@+id/textViewWeightTableUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_marginBottom="2dp" />

        <!-- Goal weight display -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/textViewGoalWeight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Goal Weight: -- lbs"
                android:textSize="16sp"
                android:textColor="#1976D2"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <ImageButton
                android:id="@+id/btnGoalWeightEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_edit"
                android:contentDescription="Edit Goal Weight"
                app:tint="#1976D2" />
        </LinearLayout>

        <!-- Scrollable weight table -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TableLayout
                android:id="@+id/tableWeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="0,1,2,3"
                android:shrinkColumns="0,1,2,3">

                <TableRow
                    android:background="#E0E0E0"
                    android:padding="6dp">

                    <TextView
                        android:id="@+id/headerDate"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Date"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="6dp"
                        android:foreground="?attr/selectableItemBackground" />

                    <TextView
                        android:id="@+id/headerWeight"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Weight"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="6dp"
                        android:foreground="?attr/selectableItemBackground" />

                    <TextView
                        android:layout_weight="0.5"
                        android:gravity="center"
                        android:text="Edit"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_weight="0.5"
                        android:gravity="center"
                        android:text="Delete"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:textSize="16sp" />
                </TableRow>

            </TableLayout>
        </ScrollView>

    </LinearLayout>

    <!-- Divider between columns -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#BDBDBD"
        android:layout_marginHorizontal="10dp" />

    <!-- RIGHT COLUMN: Search panel + Add weight panel -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Search / Filter Panel -->
            <LinearLayout
                android:id="@+id/filterPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp"
                android:background="#F5F5F5"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Search"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:layout_marginBottom="6dp" />

                <!-- Date range -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/editTextStartDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Start Date"
                        android:focusable="false"
                        android:clickable="true"
                        android:inputType="none"
                        android:background="@android:drawable/edit_text"
                        android:padding="10dp"
                        android:layout_marginEnd="6dp" />

                    <EditText
                        android:id="@+id/editTextEndDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="End Date"
                        android:focusable="false"
                        android:clickable="true"
                        android:inputType="none"
                        android:background="@android:drawable/edit_text"
                        android:padding="10dp" />
                </LinearLayout>

                <!-- Weight range -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <EditText
                        android:id="@+id/editTextMinWeight"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Min Weight"
                        android:inputType="number"
                        android:background="@android:drawable/edit_text"
                        android:padding="10dp"
                        android:layout_marginEnd="6dp" />

                    <EditText
                        android:id="@+id/editTextMaxWeight"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Max Weight"
                        android:inputType="number"
                        android:background="@android:drawable/edit_text"
                        android:padding="10dp" />
                </LinearLayout>

                <!-- Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <Button
                        android:id="@+id/btnApplyFilter"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Search"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#388E3C"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnClearFilter"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Clear"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#757575" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textViewFilterSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#444444"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

            <!-- Add Weight Panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Add Weight"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/editTextEnterDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Select Date"
                    android:focusable="false"
                    android:clickable="true"
                    android:inputType="none"
                    android:background="@android:drawable/edit_text"
                    android:padding="10dp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/setNewWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter Weight (lbs)"
                    android:inputType="number"
                    android:maxLength="3"
                    android:background="@android:drawable/edit_text"
                    android:padding="10dp"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btnAddWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#1976D2"
                    android:text="Add Weight"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:padding="12dp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
